# Choose one provider.
# For a Google AI Studio / Gemini key:
ASSISTANT_PROVIDER=google
ASSISTANT_API_KEY=replace_with_your_google_ai_studio_key
ASSISTANT_MODEL=gemini-2.0-flash
# Leave ASSISTANT_API_BASE empty for Google, or set it to the Google API base.

# For OpenAI or another OpenAI-compatible provider instead:
# ASSISTANT_PROVIDER=openai
# ASSISTANT_API_KEY=replace_with_your_server_side_key
# ASSISTANT_API_BASE=https://api.openai.com/v1
# ASSISTANT_MODEL=gpt-5-mini
