# Gemini / Google AI Studio configuration (server-only; never expose this in client code)
ASSISTANT_PROVIDER=google
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
ASSISTANT_MODEL=gemini-2.0-flash
# Optional: leave empty to use the default Google Generative Language API base.
# ASSISTANT_GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible provider alternative:
# ASSISTANT_PROVIDER=openai
# ASSISTANT_API_KEY=replace_with_your_server_side_key
# ASSISTANT_API_BASE=https://api.openai.com/v1
# ASSISTANT_MODEL=gpt-5-mini
